{
  "name": "mrig",
  "version": "0.1.0",
  "description": "mrig — a personal, local, model-agnostic coding and general-purpose agent for the terminal",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "mrig": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p vscode",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:e2e": "bun test ./e2e/app.e2e.ts",
    "build": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --define process.env.NODE_ENV='\"production\"' --outfile dist/mrig",
    "build:linux": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --define process.env.NODE_ENV='\"production\"' --target=bun-linux-x64 --outfile dist/mrig-linux-x64",
    "build:mac": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --define process.env.NODE_ENV='\"production\"' --target=bun-darwin-arm64 --outfile dist/mrig-darwin-arm64",
    "build:mac-intel": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --define process.env.NODE_ENV='\"production\"' --target=bun-darwin-x64 --outfile dist/mrig-darwin-x64",
    "build:win": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --define process.env.NODE_ENV='\"production\"' --target=bun-windows-x64 --outfile dist/mrig-windows-x64.exe",
    "build:all": "bun run build:linux && bun run build:mac && bun run build:mac-intel && bun run build:win",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run build:vscode",
    "eval": "bun run scripts/eval.ts",
    "build:vscode": "bun build ./vscode/src/extension.ts --outfile vscode/out/extension.js --target node --format cjs --external vscode --minify-syntax",
    "package:vscode": "bun run build:vscode && cd vscode && bunx @vscode/vsce@3.6.0 package --no-dependencies --out ../dist/mrig-vscode.vsix"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/gateway": "4.0.82",
    "@ai-sdk/mcp": "^2.0.91",
    "@ai-sdk/openai": "^4.0.67",
    "@ai-sdk/openai-compatible": "^3.0.49",
    "ai": "7",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "react-devtools-core": "./stubs/react-devtools-core",
    "react-dom": "^19.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19",
    "@types/vscode": "1.95.0",
    "ink-testing-library": "^4.0.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
