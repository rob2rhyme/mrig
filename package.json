{
  "name": "mrig",
  "version": "0.1.0",
  "description": "mrig — a personal, local, model-agnostic coding and general-purpose agent for the terminal",
  "type": "module",
  "private": true,
  "bin": {
    "mrig": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "build": "bun build ./src/index.ts --compile --outfile dist/mrig",
    "build:linux": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile dist/mrig-linux-x64",
    "build:mac": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/mrig-darwin-arm64",
    "build:mac-intel": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile dist/mrig-darwin-x64",
    "build:win": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile dist/mrig-windows-x64.exe",
    "build:all": "bun run build:linux && bun run build:mac && bun run build:mac-intel && bun run build:win",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "eval": "bun run scripts/eval.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/mcp": "^2.0.91",
    "@ai-sdk/openai": "^4.0.67",
    "@ai-sdk/openai-compatible": "^3.0.49",
    "ai": "7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
